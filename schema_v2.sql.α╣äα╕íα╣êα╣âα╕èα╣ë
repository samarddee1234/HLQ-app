-- ---------- สรุปฮาลาเกาะฮฺรายสัปดาห์ของกลุ่ม (มูร๊อบบีย์เขียน) ----------
create table if not exists public.weekly_summaries (
  id bigint generated always as identity primary key,
  group_id bigint not null references public.groups(id) on delete cascade,
  week_start date not null,            -- วันจันทร์ของสัปดาห์
  content text not null,
  created_by uuid default auth.uid() references public.profiles(id),
  updated_at timestamptz not null default now(),
  unique (group_id, week_start)
);

alter table public.weekly_summaries enable row level security;
drop policy if exists summ_read on public.weekly_summaries;
create policy summ_read on public.weekly_summaries for select to authenticated using (
  public.is_admin() or group_id = public.my_group()
);
drop policy if exists summ_write on public.weekly_summaries;
create policy summ_write on public.weekly_summaries for all to authenticated
  using (public.is_admin() or (public.my_role() = 'murabbi' and group_id = public.my_group()))
  with check (public.is_admin() or (public.my_role() = 'murabbi' and group_id = public.my_group()));

-- ---------- เช็คลิสต์อิบาดะฮฺ (นักเรียนบันทึกเอง เห็นเฉพาะของตัวเอง) ----------
create table if not exists public.ibadah_logs (
  id bigint generated always as identity primary key,
  student_id uuid not null default auth.uid() references public.profiles(id) on delete cascade,
  log_date date not null,
  item text not null,                  -- รหัสรายการ เช่น dhikr_morning
  unique (student_id, log_date, item)
);

alter table public.ibadah_logs enable row level security;
drop policy if exists ibadah_own on public.ibadah_logs;
create policy ibadah_own on public.ibadah_logs for all to authenticated
  using (student_id = auth.uid()) with check (student_id = auth.uid());

-- ---------- สถิติรวมของกลุ่ม (ให้นักเรียนเห็นภาพรวม โดยไม่เห็นข้อมูลรายคนของเพื่อน) ----------
create or replace function public.group_stats(weeks_back int default 8)
returns table (
  week_start date, members int, checked bigint, score numeric,
  on_time bigint, late bigint, absent bigint
)
language sql stable security definer set search_path = public as $$
  select
    date_trunc('week', pc.check_date)::date as week_start,
    count(distinct pc.student_id)::int as members,
    count(*) as checked,
    sum(case pc.status when 'on_time' then 1 when 'late' then 0.5
                       when 'excused' then 1 when 'menstruation' then 1 else 0 end) as score,
    count(*) filter (where pc.status = 'on_time') as on_time,
    count(*) filter (where pc.status = 'late') as late,
    count(*) filter (where pc.status = 'absent') as absent
  from public.prayer_checks pc
  join public.profiles p on p.id = pc.student_id
  where p.group_id is not null
    and p.group_id = public.my_group()
    and pc.check_date >= (date_trunc('week', current_date) - weeks_back * interval '1 week')::date
  group by 1
  order by 1
$$;

revoke all on function public.group_stats(int) from public, anon;
grant execute on function public.group_stats(int) to authenticated;

