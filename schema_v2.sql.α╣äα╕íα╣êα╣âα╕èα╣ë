-- ---------- คอลัมน์เพิ่มเติม ----------
-- tier: close=กลุ่มใกล้ชิด, care=กลุ่มใส่ใจ, develop=กลุ่มพัฒนา, lead=กลุ่มนำ
alter table public.groups add column if not exists tier text check (tier in ('close','care','develop','lead'));
-- stage: lower=ม.ต้น, upper=ม.ปลาย
alter table public.groups add column if not exists stage text check (stage in ('lower','upper'));
-- เพศ ใช้แสดงตัวเลือก "รอบเดือน" เฉพาะนักเรียนหญิง
alter table public.profiles add column if not exists gender text check (gender in ('male','female'));

-- ---------- หัวข้อฮาลาเกาะฮฺรายสัปดาห์ ----------
create table if not exists public.weekly_topics (
  id bigint generated always as identity primary key,
  term text not null default '2/2569',
  week_no int not null,
  halaqah_date date not null,          -- วันที่จัดฮาลาเกาะฮฺ (วันพุธ)
  kind text not null default 'normal' check (kind in ('normal','exam','lecture','joint')),
  akhlaq text,                          -- หัวข้ออัคลาก
  fiqh text,                            -- หัวข้ออัลฟิกฮ์
  special text,                         -- ใช้เมื่อทั้งสัปดาห์เป็นกิจกรรมเดียว เช่น ทดสอบ/ประเมิน
  note text,                            -- หมายเหตุ เช่น ม.5 ชายพบบาบอ
  unique (term, week_no)
);

alter table public.weekly_topics enable row level security;
drop policy if exists topics_read on public.weekly_topics;
create policy topics_read on public.weekly_topics for select to authenticated using (true);
drop policy if exists topics_admin on public.weekly_topics;
create policy topics_admin on public.weekly_topics for all to authenticated
  using (public.is_admin()) with check (public.is_admin());

